# Stripe API Keys
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret
# Get this from Stripe Dashboard > Developers > Webhooks after creating webhook endpoint
# IMPORTANT: Required for production to verify webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Vercel KV (Redis) - For Inventory Management
# These are automatically provided by Vercel when you create a KV store
# In Vercel Dashboard: Storage > Create Database > KV
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# Admin Password
# Used for admin endpoints like inventory initialization
# Change this to a secure password in production
ADMIN_PASSWORD=changeme

# --- Cake order notifications (all optional; each feature off when blank) ---

# Email the shop when a cake order comes in, via Resend (https://resend.com).
# RESEND_API_KEY: from the Resend dashboard.
# ORDER_NOTIFY_EMAIL: where order alerts go (defaults to thescoopcompany@mail.com).
# ORDER_NOTIFY_FROM: a Resend-verified sender. Use onboarding@resend.dev until the
#   domain is verified, then e.g. orders@thescoopcompany.co.uk.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=thescoopcompany@mail.com
ORDER_NOTIFY_FROM=onboarding@resend.dev

# Push cake orders into Scoop Inbox (the CRM) as a conversation, via its Forms
# webhook. Both required for this to fire.
SCOOP_INBOX_URL=https://scoop-inbox-production.up.railway.app
SCOOP_INBOX_FORMS_SECRET=
